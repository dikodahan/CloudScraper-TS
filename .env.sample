# Copy to .env for local testing. Values here are not committed.

# FlareSolverr (optional). Default solver uses this after patchright.
# FLARESOLVERR_URL=http://localhost:8191/v1

# Browserless CDP (optional). Requires puppeteer-core.
# BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io?token=YOUR_API_KEY

# One-shot CLI default URL (test/server.js run)
# TEST_URL=https://nowsecure.nl/

# Local browser solver (no env): pnpm add patchright && pnpm exec patchright install chromium
