{
  "name": "cloudscraper-ts",
  "version": "2.0.0",
  "description": "Bypasses Cloudflare JS challenges and anti-bot interstitial pages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "node --test test/detect.test.js && node test/targets.js",
    "test:server": "node test/server.js",
    "test:once": "node test/server.js run",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "prepare": "tsc --build",
    "eslint": "eslint .",
    "prettier": "prettier --write .",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dikodahan/CloudScraper-TS.git"
  },
  "author": "eltik",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dikodahan/CloudScraper-TS/issues"
  },
  "homepage": "https://github.com/dikodahan/CloudScraper-TS#readme",
  "dependencies": {
    "got": "^15.1.0",
    "tough-cookie": "^6.0.2"
  },
  "peerDependencies": {
    "impit": "^0.14.4",
    "patchright": "^1.62.2",
    "puppeteer-core": "*"
  },
  "peerDependenciesMeta": {
    "impit": {
      "optional": true
    },
    "patchright": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "playwright": "^1.58.2",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "optionalDependencies": {
    "impit": "^0.14.4",
    "patchright": "^1.62.3"
  }
}
